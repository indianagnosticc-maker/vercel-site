<script>
/* ============ AUDIO ENGINE ============ */
let soundEnabled = true;
let masterVolume = 0.06;
let audioCtx = null;

function getAudioContext(){
  if (!audioCtx){
    const AC = window.AudioContext || window.webkitAudioContext;
    if (AC) audioCtx = new AC();
  }
  if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
  return audioCtx;
}

function playSound(type){
  if (!soundEnabled || masterVolume <= 0.001) return;
  const ctx = getAudioContext();
  if (!ctx) return;
  const now = ctx.currentTime;

  if (type === "tab" || type === "toggle"){
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(type === "tab" ? 1400 : 980, now);
    osc.frequency.exponentialRampToValueAtTime(800, now + 0.035);
    gain.gain.setValueAtTime(masterVolume * 0.7, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.04);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.045);
  } else if (type === "scan"){
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = "triangle";
    osc.frequency.setValueAtTime(320, now);
    osc.frequency.exponentialRampToValueAtTime(780, now + 0.08);
    gain.gain.setValueAtTime(masterVolume * 0.8, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.1);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.11);
  } else if (type === "success"){
    [523.25, 659.25].forEach((freq, i) => {
      const osc = ctx.createOscillator(), gain = ctx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(freq, now + i * 0.07);
      gain.gain.setValueAtTime(masterVolume * 0.85, now + i * 0.07);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.07 + 0.18);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(now + i * 0.07); osc.stop(now + i * 0.07 + 0.19);
    });
  } else if (type === "error"){
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(110, now);
    osc.frequency.exponentialRampToValueAtTime(60, now + 0.15);
    gain.gain.setValueAtTime(masterVolume * 1.1, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.16);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.17);
  } else if (type === "packet"){
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(1200, now);
    osc.frequency.exponentialRampToValueAtTime(700, now + 0.02);
    gain.gain.setValueAtTime(masterVolume * 0.45, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.022);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.025);
  }
}

window.addEventListener("pointerdown", () => getAudioContext(), { once: true });
window.addEventListener("keydown", () => getAudioContext(), { once: true });

/* ============ RED PARTICLE SNOWFALL ============ */
let particlesActive = true;
const canvas = document.getElementById("particles");
const pctx = canvas.getContext("2d");
let particles = [];
let isDocVisible = !document.hidden;

function resizeCanvas(){
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  initParticles();
}

function initParticles(){
  particles = [];
  const count = Math.min(140, Math.max(90, Math.floor(canvas.width / 10)));
  for (let i = 0; i < count; i++){
    const sizeType = Math.random();
    let r, vy;
    if (sizeType < 0.7){ r = Math.random() * 0.6 + 0.9; vy = Math.random() * 0.18 + 0.15; }
    else if (sizeType < 0.92){ r = Math.random() * 0.5 + 1.6; vy = Math.random() * 0.18 + 0.28; }
    else { r = Math.random() * 0.6 + 2.4; vy = Math.random() * 0.18 + 0.4; }
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: r,
      vy: vy,
      baseAlpha: Math.random() * 0.22 + 0.22,
      swayAngle: Math.random() * Math.PI * 2,
      swaySpeed: Math.random() * 0.01 + 0.005,
      swayAmplitude: Math.random() * 0.55 + 0.35,
      isGlow: r >= 2.2,
      hue: Math.random() < 0.12 ? "cyan" : (Math.random() < 0.08 ? "purple" : "red")
    });
  }
}

window.addEventListener("resize", resizeCanvas);
resizeCanvas();

document.addEventListener("visibilitychange", () => { isDocVisible = !document.hidden; });

function renderParticles(){
  requestAnimationFrame(renderParticles);
  if (!particlesActive || !isDocVisible) return;
  pctx.clearRect(0, 0, canvas.width, canvas.height);

  for (let i = 0; i < particles.length; i++){
    const p = particles[i];
    p.y += p.vy;
    p.swayAngle += p.swaySpeed;
    p.x += Math.sin(p.swayAngle) * p.swayAmplitude;

    if (p.y > canvas.height + 12){ p.y = -12; p.x = Math.random() * canvas.width; }
    if (p.x < -12) p.x = canvas.width + 12;
    else if (p.x > canvas.width + 12) p.x = -12;

    pctx.save();
    let color;
    if (p.hue === "cyan") color = `rgba(34,211,238,${p.baseAlpha})`;
    else if (p.hue === "purple") color = `rgba(167,139,250,${p.baseAlpha})`;
    else color = `rgba(255,45,85,${p.baseAlpha})`;
    pctx.fillStyle = color;

    if (p.isGlow){
      if (p.hue === "cyan") pctx.shadowColor = "rgba(34,211,238,0.8)";
      else if (p.hue === "purple") pctx.shadowColor = "rgba(167,139,250,0.8)";
      else pctx.shadowColor = "rgba(255,45,85,0.8)";
      pctx.shadowBlur = 8;
    } else {
      pctx.shadowColor = "transparent";
      pctx.shadowBlur = 0;
    }

    pctx.beginPath();
    pctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    pctx.fill();
    pctx.restore();
  }
}
requestAnimationFrame(renderParticles);

/* ============ SETTINGS DRAWER ============ */
const drawer = document.getElementById("settings-drawer");
const drawerBackdrop = document.getElementById("drawer-backdrop");
const btnOpenSettings = document.getElementById("btn-open-settings");
const btnCloseSettings = document.getElementById("btn-close-settings");

function openSettings(){ drawer.classList.add("open"); drawerBackdrop.classList.add("open"); playSound("tab"); }
function closeSettings(){ drawer.classList.remove("open"); drawerBackdrop.classList.remove("open"); playSound("toggle"); }
btnOpenSettings.addEventListener("click", openSettings);
btnCloseSettings.addEventListener("click", closeSettings);
drawerBackdrop.addEventListener("click", closeSettings);

const toggleParticles = document.getElementById("toggle-particles");
toggleParticles.addEventListener("change", e => {
  particlesActive = e.target.checked;
  playSound("toggle");
  if (!particlesActive) pctx.clearRect(0, 0, canvas.width, canvas.height);
});

const toggleSound = document.getElementById("toggle-sound");
toggleSound.addEventListener("change", e => {
  soundEnabled = e.target.checked;
  if (soundEnabled) playSound("toggle");
});

const volumeSlider = document.getElementById("volume-slider");
const volValTxt = document.getElementById("vol-val-txt");
volumeSlider.addEventListener("input", e => {
  const v = parseInt(e.target.value);
  volValTxt.textContent = v + "%";
