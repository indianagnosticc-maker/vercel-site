const FIELD_MAP = [
  ["owner name",       ["Owner Name","owner_name","owner","Owner","name"]],
  ["owner serial",     ["Owner Serial No.","owner_serial_no","owner_serial","serial"]],
  ["father name",      ["Father Name","father_name","father"]],
  ["maker",            ["Model Name","maker_name","maker","Maker Model","Maker"]],
  ["model",            ["Maker Model","model","model_name","vehicle_model"]],
  ["fuel type",        ["Fuel Type","fuel_type","fuel"]],
  ["fuel norms",       ["Fuel Norms","fuel_norms","norms"]],
  ["vehicle class",    ["Vehicle Class","vehicle_class","class","vclass"]],
  ["reg. date",        ["Registration Date","registration_date","reg_date","regdate"]],
  ["registered rto",   ["Registered RTO","registered_rto","rto","rto_name"]],
  ["fitness upto",     ["Fitness Upto","fitness_upto","fitness"]],
  ["insurance co.",    ["Insurance Company","insurance_company","insurer"]],
  ["insurance no.",    ["Insurance No.","insurance_no","policy_no"]],
  ["insurance upto",   ["Insurance Upto","insurance_upto","insurance_expiry"]],
  ["puc no.",          ["PUC No.","puc_no"]],
  ["puc upto",         ["PUC Upto","puc_upto"]],
  ["tax upto",         ["Tax Upto","tax_upto"]],
  ["chassis no.",      ["Chassis No.","chassis_no","chassis","chassis_number"]],
  ["engine no.",       ["Engine No.","engine_no","engine","engine_number"]],
  ["phone",            ["Phone","phone","mobile","contact"]],
  ["email",            ["Email","email"]],
  ["address",          ["Address","address","present_address","permanent_address"]],
  ["city",             ["City Name","city","city_name"]],
  ["state",            ["State","state"]],
  ["pincode",          ["Pincode","pincode","pin"]],
];

function getField(data, keys){
  for (const k of keys){
    if (k in data && data[k] !== null && data[k] !== undefined){
      const v = String(data[k]).trim();
      if (v && v !== "null" && v !== "NA" && v !== "N/A" && v !== "-") return v;
    }
  }
  return null;
}

function renderVehicle(payload){
  outVosint.innerHTML = "";
  if (!payload || typeof payload !== "object"){
    outVosint.innerHTML = `<div class="card"><div class="body"><div class="vrow"><div class="vk">RESULT</div><div class="fill"></div><div class="vv na">Vehicle not found in registry</div></div></div></div>`;
    return;
  }
  let data = payload;
  for (const w of ["data","result","vehicle","rc","details"]){
    if (data[w] && typeof data[w] === "object" && !Array.isArray(data[w])){ data = data[w]; break; }
  }
  if (Array.isArray(data) && data.length) data = data[0];

  const rows = []; let found = 0;
  for (const [label, keys] of FIELD_MAP){
    const v = getField(data, keys);
    if (v){
      found++;
      const hi = ["owner name","reg. date","phone","chassis no.","engine no."].includes(label);
      rows.push(`<div class="vrow"><div class="vk">${esc(label)}</div><div class="fill"></div><div class="vv${hi?" hi":""}">${esc(v)}</div></div>`);
    }
  }
  if (found === 0){
    let msg = "No publicly indexed record found";
    if (typeof data.message === "string") msg = data.message;
    else if (typeof data.error === "string") msg = data.error;
    outVosint.innerHTML = `<div class="card"><div class="body"><div class="vrow"><div class="vk">STATUS</div><div class="fill"></div><div class="vv na">${esc(msg)}</div></div></div></div>`;
    return;
  }
  outVosint.innerHTML = `<div class="card">
    <div class="head" style="color:var(--cyan);background:linear-gradient(180deg, rgba(34,211,238,0.08), transparent);">
      <span>RC DOSSIER</span><span class="badge">VERIFIED</span>
    </div>
    <div class="body">${rows.join("")}</div>
  </div>`;
  outVosint.innerHTML += `<details style="margin-top:10px"><summary style="color:var(--cyan)">RAW REGISTRY DUMP</summary><pre class="raw">${esc(JSON.stringify(payload,null,2))}</pre></details>`;
}

