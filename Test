<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>CYBER//OSINT • RED TERMINAL</title>
<style>
  :root{
    --bg:#000000;
    --panel:rgba(8,4,6,0.72);
    --panel-solid:#0a0507;
    --panel-border:rgba(255,45,85,0.16);
    --panel-border-strong:rgba(255,45,85,0.42);
    --red:#ff2d55;
    --red-2:#ff4d6d;
    --red-3:#dc1e40;
    --red-glow:rgba(255,45,85,0.35);
    --red-glow-soft:rgba(255,45,85,0.14);
    --cyan:#22d3ee;
    --cyan-glow:rgba(34,211,238,0.35);
    --purple:#a78bfa;
    --purple-glow:rgba(167,139,250,0.35);
    --white:#f5f7fa;
    --dim:#7a8a9a;
    --dim-2:#a8b8c8;
    --radius-sm:8px;
    --radius-md:12px;
    --radius-lg:18px;
    --radius-xl:24px;
    --font-mono:ui-monospace,"JetBrains Mono","SF Mono",Menlo,Consolas,monospace;
  }

  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0;}

  html,body{
    background:#000;
    color:var(--white);
    font-family:var(--font-mono);
    font-size:13.5px;
    line-height:1.6;
    min-height:100vh;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  /* ============ BACKGROUND FX LAYERS ============ */
  .bg-fx{position:fixed;inset:0;pointer-events:none;z-index:0;}

  /* Deep radial red glow */
  .bg-fx.glow{
    background:
      radial-gradient(circle at 50% 0%, rgba(255,45,85,0.16) 0%, transparent 55%),
      radial-gradient(circle at 15% 90%, rgba(167,139,250,0.07) 0%, transparent 50%),
      radial-gradient(circle at 85% 75%, rgba(34,211,238,0.05) 0%, transparent 50%);
    animation:glowPulse 8s ease-in-out infinite;
  }
  @keyframes glowPulse{
    0%,100%{opacity:1;}
    50%{opacity:0.72;}
  }

  /* Hex grid */
  .bg-fx.hex{
    background-image:
      linear-gradient(rgba(255,45,85,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,45,85,0.045) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(circle at 50% 40%, #000 20%, transparent 85%);
    -webkit-mask-image:radial-gradient(circle at 50% 40%, #000 20%, transparent 85%);
    opacity:0.75;
    animation:gridDrift 24s linear infinite;
  }
  @keyframes gridDrift{
    0%{background-position:0 0, 0 0;}
    100%{background-position:44px 44px, 44px 44px;}
  }

  /* Scanline sweep */
  .bg-fx.scan{
    background:linear-gradient(180deg, transparent 0%, rgba(255,45,85,0.09) 48%, rgba(255,45,85,0.22) 50%, rgba(255,45,85,0.09) 52%, transparent 100%);
    height:180px;
    top:-180px;
    animation:scanSweep 6s linear infinite;
    mix-blend-mode:screen;
  }
  @keyframes scanSweep{
    0%{transform:translateY(0);}
    100%{transform:translateY(calc(100vh + 180px));}
  }

  /* Grain */
  .bg-fx.grain{
    opacity:0.05;
    mix-blend-mode:overlay;
  }

  /* Particles canvas */
  #particles{
    position:fixed;inset:0;width:100%;height:100%;
    pointer-events:none;z-index:1;
  }

  /* ============ TOP BAR ============ */
  .topbar{
    position:relative;z-index:30;
    width:100%;max-width:680px;margin:0 auto;
    padding:18px 20px 14px;
    display:flex;justify-content:space-between;align-items:center;
  }
  .brand{
    display:flex;align-items:center;gap:10px;
    font-size:11px;font-weight:700;letter-spacing:2.4px;
    color:var(--white);text-transform:uppercase;
  }
  .live-dot{
    width:7px;height:7px;border-radius:50%;
    background:var(--red);
    box-shadow:0 0 10px var(--red),0 0 20px var(--red-glow);
    animation:pulseDot 2.2s infinite;
  }
  @keyframes pulseDot{
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:0.4;transform:scale(0.82);}
  }
  .brand-txt em{color:var(--red);font-style:normal;}

  .icon-btn{
    width:40px;height:40px;
    background:rgba(255,45,85,0.06);
    border:1px solid var(--panel-border);
    color:var(--dim-2);
    border-radius:50%;
    display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;
    transition:transform 200ms cubic-bezier(0.16,1,0.3,1), border-color 200ms, color 200ms, box-shadow 200ms, background 200ms;
  }
  .icon-btn:hover{
    color:var(--red);
    border-color:var(--red);
    background:rgba(255,45,85,0.12);
    box-shadow:0 0 18px var(--red-glow);
    transform:scale(1.06);
  }
  .icon-btn:active{transform:scale(0.94);}
  .icon-btn svg{transition:transform 400ms cubic-bezier(0.16,1,0.3,1);}
  .icon-btn:hover svg{transform:rotate(60deg);}

  .topbar-line{
    width:100%;height:1px;
    background:linear-gradient(90deg, transparent 0%, var(--red) 50%, transparent 100%);
    box-shadow:0 0 12px var(--red-glow),0 0 24px var(--red-glow-soft);
    position:relative;z-index:30;
    animation:lineShimmer 4s ease-in-out infinite;
  }
  @keyframes lineShimmer{
    0%,100%{opacity:0.7;}
    50%{opacity:1;}
  }

  /* ============ SETTINGS DRAWER ============ */
  .drawer-backdrop{
    position:fixed;inset:0;
    background:rgba(0,0,0,0.72);
    backdrop-filter:blur(6px);
    -webkit-backdrop-filter:blur(6px);
    z-index:900;
    opacity:0;pointer-events:none;
    transition:opacity 260ms ease;
  }
  .drawer-backdrop.open{opacity:1;pointer-events:auto;}

  .drawer{
    position:fixed;top:0;right:0;bottom:0;
    width:100%;max-width:360px;
    background:rgba(5,2,4,0.96);
    backdrop-filter:blur(28px);
    -webkit-backdrop-filter:blur(28px);
    border-left:1px solid var(--panel-border);
    z-index:999;padding:26px 22px;
    transform:translateX(100%);
    transition:transform 340ms cubic-bezier(0.16,1,0.3,1);
    display:flex;flex-direction:column;gap:20px;
    box-shadow:-16px 0 48px rgba(255,45,85,0.08),-8px 0 32px rgba(0,0,0,0.7);
  }
  .drawer.open{transform:translateX(0);}
  .drawer-head{
    display:flex;justify-content:space-between;align-items:center;
    padding-bottom:16px;border-bottom:1px solid var(--panel-border);
  }
  .drawer-title{
    font-size:12px;letter-spacing:2.4px;color:var(--white);
    font-weight:700;text-transform:uppercase;
  }
  .drawer-title span{color:var(--red);}
  .drawer-close{
    background:transparent;border:none;color:var(--dim-2);cursor:pointer;
    width:34px;height:34px;display:flex;align-items:center;justify-content:center;
    border-radius:8px;transition:all 200ms;
  }
  .drawer-close:hover{color:var(--red);transform:scale(1.1);}

  .drawer-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:8px 0;font-size:12.5px;color:var(--dim-2);
  }
  .drawer-item span{letter-spacing:1px;font-size:11.5px;}

  .switch{position:relative;display:inline-block;width:46px;height:26px;flex-shrink:0;}
  .switch input{opacity:0;width:0;height:0;}
  .slider{
    position:absolute;inset:0;cursor:pointer;
    background:rgba(122,138,154,0.2);
    border:1px solid var(--panel-border);
    border-radius:26px;
    transition:all 220ms;
  }
  .slider:before{
    content:"";position:absolute;
    height:20px;width:20px;left:2px;bottom:2px;
    background:#7a8a9a;border-radius:50%;
    transition:transform 280ms cubic-bezier(0.16,1,0.3,1), background 220ms;
    box-shadow:0 2px 6px rgba(0,0,0,0.5);
  }
  input:checked + .slider{
    background:linear-gradient(180deg, var(--red), var(--red-3));
    border-color:var(--red);
    box-shadow:0 0 14px var(--red-glow);
  }
  input:checked + .slider:before{
    transform:translateX(20px);background:#fff;
  }

  .volume-row{display:flex;flex-direction:column;gap:10px;padding:6px 0 10px;}
  .volume-head{display:flex;justify-content:space-between;font-size:11.5px;letter-spacing:1px;color:var(--dim-2);}
  .volume-head span:last-child{color:var(--red);font-weight:700;}
  .vol-slider{
    -webkit-appearance:none;width:100%;height:4px;border-radius:99px;
    background:rgba(122,138,154,0.2);outline:none;cursor:pointer;
  }
  .vol-slider::-webkit-slider-thumb{
    -webkit-appearance:none;width:16px;height:16px;border-radius:50%;
    background:var(--red);cursor:pointer;
    box-shadow:0 0 10px var(--red-glow),0 0 20px var(--red-glow-soft);
    border:2px solid #fff;
  }
  .vol-slider::-moz-range-thumb{
    width:14px;height:14px;border-radius:50%;
    background:var(--red);cursor:pointer;border:2px solid #fff;
    box-shadow:0 0 10px var(--red-glow);
  }

  .drawer-section-label{
    font-size:10.5px;letter-spacing:2px;color:var(--dim);
    text-transform:uppercase;display:block;margin-bottom:10px;
  }
  .drawer-link{
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 14px;border-radius:var(--radius-md);
    background:rgba(255,45,85,0.05);
    border:1px solid var(--panel-border);
    color:var(--white);text-decoration:none;
    font-size:11.5px;letter-spacing:1.5px;font-weight:600;
    transition:all 220ms cubic-bezier(0.16,1,0.3,1);
    margin-bottom:8px;
  }
  .drawer-link:hover{
    background:rgba(255,45,85,0.12);
    border-color:var(--red);
    transform:translateX(4px);
    box-shadow:0 0 18px var(--red-glow-soft);
  }
  .drawer-link span:last-child{color:var(--red);font-size:14px;}

  /* ============ MAIN WRAP ============ */
  .wrap{
    position:relative;z-index:20;
    max-width:680px;margin:0 auto;
    padding:20px 20px 60px;
    display:flex;flex-direction:column;
  }

  /* ============ TABS ============ */
  .nav-tabs-container{
    position:relative;display:flex;justify-content:center;
    margin:8px 0 32px;
  }
  .nav-tabs{
    display:inline-flex;align-items:center;gap:22px;
    position:relative;padding:4px 6px 2px;
  }
  .tab-indicator{
    position:absolute;bottom:0;left:0;height:3px;
    background:var(--red);
    border-radius:99px;
    box-shadow:0 0 10px var(--red-glow),0 0 20px var(--red-glow-soft);
    transition:left 320ms cubic-bezier(0.4,0,0.2,1), width 320ms cubic-bezier(0.4,0,0.2,1), background 320ms;
    pointer-events:none;
  }
  .tab-btn{
    background:transparent;border:none;cursor:pointer;
    font:inherit;font-size:12.5px;letter-spacing:2.4px;font-weight:600;
    color:var(--dim);padding:10px 6px 12px;
    text-transform:uppercase;
    transition:color 200ms, transform 200ms;
    position:relative;
  }
  .tab-btn:hover{color:var(--dim-2);transform:translateY(-1px);}
  .tab-btn:active{transform:scale(0.96);}
  .tab-btn.active{color:var(--white);text-shadow:0 0 12px var(--red-glow);}

  /* ============ PAGES ============ */
  .page{display:none;flex-direction:column;width:100%;}
  .page.active{display:flex;animation:pageIn 320ms cubic-bezier(0.16,1,0.3,1) both;}
  @keyframes pageIn{
    from{opacity:0;transform:translateY(8px);}
    to{opacity:1;transform:none;}
  }

  .title-wrap{text-align:center;margin-bottom:22px;}
  .title{
    font-size:38px;font-weight:800;letter-spacing:5px;
    color:var(--white);
    text-shadow:0 0 28px var(--red-glow),0 0 60px var(--red-glow-soft);
    margin:0 0 8px;
    font-family:var(--font-mono);
  }
  .title .accent{color:var(--red);}
  .sub{
    font-size:11px;letter-spacing:2.4px;color:var(--dim-2);
    text-transform:uppercase;
  }

  /* Info box */
  .info-box{
    width:100%;
    border-radius:var(--radius-md);
    padding:14px 16px;
    font-size:11.5px;
    line-height:1.65;
    margin-bottom:18px;
    background:linear-gradient(135deg, rgba(255,45,85,0.06), rgba(255,45,85,0.02));
    border:1px solid var(--panel-border);
    color:var(--dim-2);
    position:relative;
    overflow:hidden;
  }
  .info-box::before{
    content:"";position:absolute;left:0;top:0;bottom:0;width:3px;
    background:var(--red);
    box-shadow:0 0 8px var(--red-glow);
  }

  /* ============ FORMS ============ */
  form.search-box{
    display:flex;align-items:center;gap:8px;
    background:rgba(8,4,6,0.72);
    border:1px solid var(--panel-border);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border-radius:var(--radius-lg);
    padding:6px 6px 6px 16px;
    transition:border-color 220ms, box-shadow 220ms, transform 220ms;
    box-shadow:0 8px 32px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.03);
  }
  form.search-box:focus-within{
    border-color:var(--red);
    box-shadow:0 0 0 1px var(--red),0 0 24px var(--red-glow-soft),0 8px 32px rgba(0,0,0,0.5);
  }
  form.cyan:focus-within{
    border-color:var(--cyan);
    box-shadow:0 0 0 1px var(--cyan),0 0 24px var(--cyan-glow),0 8px 32px rgba(0,0,0,0.5);
  }
  form.red:focus-within{
    border-color:var(--red);
    box-shadow:0 0 0 1px var(--red),0 0 24px var(--red-glow),0 8px 32px rgba(0,0,0,0.5);
  }
  form.pink:focus-within{
    border-color:var(--purple);
    box-shadow:0 0 0 1px var(--purple),0 0 24px var(--purple-glow),0 8px 32px rgba(0,0,0,0.5);
  }

  .prompt-icon{
    font-size:14px;color:var(--red);font-weight:700;
    user-select:none;flex-shrink:0;
    text-shadow:0 0 10px var(--red-glow);
  }
  form.cyan .prompt-icon{color:var(--cyan);text-shadow:0 0 10px var(--cyan-glow);}
  form.pink .prompt-icon{color:var(--purple);text-shadow:0 0 10px var(--purple-glow);}

  input{
    flex:1;min-width:0;background:transparent;border:0;outline:0;
    color:var(--white);font:inherit;font-size:13.5px;
    padding:9px 6px;letter-spacing:0.4px;
    caret-color:var(--red);
  }
  form.cyan input{caret-color:var(--cyan);}
  form.pink input{caret-color:var(--purple);}
  input::placeholder{color:var(--dim);opacity:0.75;}

  /* ============ SCAN BUTTON ============ */
  .scan-btn{
    position:relative;overflow:hidden;
    background:linear-gradient(180deg, var(--red-2), var(--red-3));
    color:#fff;font-weight:700;font-size:11.5px;letter-spacing:1.8px;
    border:none;border-radius:var(--radius-md);
    padding:10px 20px;cursor:pointer;min-height:40px;
    box-shadow:0 4px 18px var(--red-glow),inset 0 1px 0 rgba(255,255,255,0.18);
    display:inline-flex;align-items:center;justify-content:center;
    transition:transform 180ms cubic-bezier(0.16,1,0.3,1), box-shadow 220ms, opacity 220ms;
    font-family:var(--font-mono);
    text-transform:uppercase;
  }
  .scan-btn::before{
    content:"";position:absolute;inset:0;
    background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.4) 50%, transparent 100%);
    transform:translateX(-120%);
    animation:shimmerSweep 3.2s infinite ease-in-out;
    pointer-events:none;
  }
  @keyframes shimmerSweep{
    0%{transform:translateX(-120%);}
    40%,100%{transform:translateX(120%);}
  }
  .scan-btn::after{
    content:"";position:absolute;inset:0;
    border-radius:inherit;border:2px solid #fff;
    opacity:0;pointer-events:none;transform:scale(0.85);
  }
  .scan-btn.clicked::after{animation:pulseRing 0.4s ease-out forwards;}
  @keyframes pulseRing{
    0%{transform:scale(0.9);opacity:0.8;}
    100%{transform:scale(1.35);opacity:0;}
  }
  .scan-btn:hover{
    transform:scale(1.03);
    box-shadow:0 0 26px var(--red-glow),0 4px 18px var(--red-glow),inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .scan-btn:active{transform:scale(0.95);}
  .scan-btn:disabled{opacity:0.5;cursor:wait;transform:none;}

  .scan-btn.cyan{
    background:linear-gradient(180deg, var(--cyan), #0891b2);
    color:#05080f;
    box-shadow:0 4px 18px var(--cyan-glow),inset 0 1px 0 rgba(255,255,255,0.3);
  }
  .scan-btn.cyan:hover{box-shadow:0 0 26px var(--cyan-glow),0 4px 18px var(--cyan-glow);}
  .scan-btn.pink{
    background:linear-gradient(180deg, var(--purple), #7c3aed);
    color:#fff;
    box-shadow:0 4px 18px var(--purple-glow),inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .scan-btn.pink:hover{box-shadow:0 0 26px var(--purple-glow),0 4px 18px var(--purple-glow);}

  /* ============ STATUS ============ */
  .status{
    font-size:11.5px;color:var(--dim-2);letter-spacing:0.7px;
    margin:16px 4px 0;min-height:20px;
    display:flex;align-items:center;gap:10px;
    animation:fadeIn 240ms ease;
  }
  .status.err{
    color:var(--red);
    padding:10px 14px;
    border-left:3px solid var(--red);
    background:rgba(255,45,85,0.07);
    border-radius:0 var(--radius-sm) var(--radius-sm) 0;
    box-shadow:0 0 18px var(--red-glow-soft);
  }
  .status.ok{color:var(--red);text-shadow:0 0 10px var(--red-glow-soft);}
  .loader{
    display:inline-block;width:12px;height:12px;
    border:2px solid rgba(255,45,85,0.2);
    border-top-color:var(--red);
    border-radius:50%;animation:spin 0.7s linear infinite;flex-shrink:0;
    box-shadow:0 0 8px var(--red-glow);
  }
  .loader.cyan{border-color:rgba(34,211,238,0.2);border-top-color:var(--cyan);box-shadow:0 0 8px var(--cyan-glow);}
  .loader.purple{border-color:rgba(167,139,250,0.2);border-top-color:var(--purple);box-shadow:0 0 8px var(--purple-glow);}
  @keyframes spin{100%{transform:rotate(360deg);}}

  /* ============ OUTPUT CARDS ============ */
  .out{margin-top:22px;width:100%;}
  .card{
    background:rgba(8,4,6,0.72);
    border:1px solid var(--panel-border);
    backdrop-filter:blur(22px);
    -webkit-backdrop-filter:blur(22px);
    border-radius:var(--radius-lg);
    margin-bottom:16px;overflow:hidden;
    animation:cardIn 340ms cubic-bezier(0.16,1,0.3,1) both;
    box-shadow:0 10px 40px rgba(0,0,0,0.55),inset 0 1px 0 rgba(255,255,255,0.03);
    position:relative;
  }
  .card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg, transparent, var(--red), transparent);
    opacity:0.55;
  }
  @keyframes cardIn{
    from{opacity:0;transform:translateY(14px) scale(0.99);}
    to{opacity:1;transform:none;}
  }
  .card .head{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 18px;
    background:linear-gradient(180deg, rgba(255,45,85,0.08), transparent);
    border-bottom:1px solid var(--panel-border);
    font-size:11px;letter-spacing:1.8px;color:var(--red);font-weight:700;
    text-transform:uppercase;
  }
  .card .head .badge{
    color:var(--dim-2);font-size:10px;letter-spacing:1.2px;
    padding:3px 8px;border:1px solid var(--panel-border);border-radius:99px;
  }
  .card .body{padding:14px 18px;}

  .row{
    display:grid;grid-template-columns:140px 1fr;gap:14px;
    font-size:12.5px;padding:9px 0;
    border-bottom:1px solid rgba(255,45,85,0.06);
    align-items:baseline;
  }
  .row:last-child{border-bottom:none;}
  .row .k{
    color:var(--dim);font-size:10.5px;letter-spacing:1px;
    text-transform:uppercase;
  }
  .row .v{color:var(--white);word-break:break-word;font-weight:500;}
  .row .v.hi{color:var(--red);font-weight:700;text-shadow:0 0 10px var(--red-glow-soft);}
  .row .v.na{color:var(--dim);font-style:italic;}

  /* V-OSINT dotted lines */
  .vrow{display:flex;align-items:baseline;gap:10px;font-size:12.5px;padding:9px 0;width:100%;}
  .vrow .vk{
    color:var(--cyan);font-size:10.5px;letter-spacing:1px;
    text-transform:uppercase;flex-shrink:0;font-weight:600;
  }
  .vrow .fill{flex:1;border-bottom:1px dotted rgba(34,211,238,0.35);margin-bottom:4px;min-width:10px;}
  .vrow .vv{color:var(--white);text-align:right;word-break:break-word;max-width:66%;font-weight:500;}
  .vrow .vv.hi{color:var(--cyan);font-weight:700;text-shadow:0 0 10px var(--cyan-glow);}
  .vrow .vv.na{color:var(--dim);font-style:italic;}

  pre.raw{
    background:rgba(0,0,0,0.72);
    border:1px solid var(--panel-border);
    border-radius:var(--radius-sm);
    padding:12px 14px;font-size:11px;color:var(--dim-2);
