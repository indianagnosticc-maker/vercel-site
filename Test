function setStatusOsint(msg, cls){ statusOsint.className = "status " + (cls||""); statusOsint.innerHTML = msg || ""; }
function loadingOsint(n){
  statusOsint.className = "status";
  statusOsint.innerHTML = `<span class="loader"></span>SEARCHING FOR ${esc(n)}...`;
  playSound("scan");
