function isLeakedRecord(r){
  if (!r || typeof r !== "object") return false;
  const fields = ["name","fname","father_name","address","alt","alt_number","email","circle","id","mobile","phone","aadhaar","pan"];
  let score = 0;
  for (const f of fields){
    const v = r[f];
    if (v === null || v === undefined) continue;
    const s = String(v).trim();
    if (!s || s === "null" || s === " ") continue;
    score++;
  }
  const hasName = (r.name && String(r.name).trim().length > 1) ||
                  (r.fname && String(r.fname).trim().length > 1) ||
                  (r.father_name && String(r.father_name).trim().length > 1);
  return hasName && score >= 3;
}

function renderObj(obj, prefix){
  const rows = [];
  for (const [k, v] of Object.entries(obj)){
    if (v === null || v === undefined || v === "") continue;
    const label = prefix ? `${prefix}.${k}` : k;
    if (typeof v !== "object"){
      const hi = ["mobile","phone","number","email","id","name","father_name","fname","alt","alt_number"].includes(k);
      rows.push(`<div class="row"><div class="k">${esc(label)}</div><div class="v${hi?" hi":""}">${esc(String(v))}</div></div>`);
    } else if (Array.isArray(v)){
      if (!v.length) continue;
      if (v.every(x => x === null || typeof x !== "object")){
        rows.push(`<div class="row"><div class="k">${esc(label)}</div><div class="v">${esc(v.join(", "))}</div></div>`);
      } else {
        rows.push(`<div class="row"><div class="k">${esc(label)}</div><div class="v">[${v.length} record${v.length>1?"s":""}]</div></div>`);
        v.forEach((item, i) => { if (item && typeof item === "object") rows.push(renderObj(item, `${label}[${i+1}]`)); });
      }
    } else {
      rows.push(renderObj(v, label));
    }
  }
  return rows.join("");
}

function renderPayload(data){
  outOsint.innerHTML = "";
  let records = null, envelope = data;
  for (const w of ["result","data","records","rows","items"]){
    if (Array.isArray(envelope[w])){ records = envelope[w]; break; }
    if (envelope[w] && typeof envelope[w] === "object"){
      for (const w2 of ["data","records","rows","items","result"]){
        if (Array.isArray(envelope[w][w2])){ records = envelope[w][w2]; envelope = envelope[w]; break; }
      }
      if (records) break;
    }
  }
  if (!records && Array.isArray(data)) records = data;
  if (!records || !records.length){
    outOsint.innerHTML = `<div class="card"><div class="head"><span>RECORD PAYLOAD</span><span class="badge">DIRECT</span></div><div class="body">${renderObj(data)}</div></div>`;
    outOsint.innerHTML += `<details style="margin-top:10px"><summary>RAW LOG JSON</summary><pre class="raw">${esc(JSON.stringify(data,null,2))}</pre></details>`;
    return;
  }
  const leaked = records.filter(isLeakedRecord);
  if (!leaked.length){
    outOsint.innerHTML = `<div class="card"><div class="body"><div class="row"><div class="k">STATUS</div><div class="v na">No breach records identified</div></div></div></div>`;
    return;
  }
  let html = "";
  leaked.forEach((rec, i) => {
    html += `<div class="card">
      <div class="head"><span>RECORD #${String(i+1).padStart(2,"0")}</span><span class="badge">VERIFIED</span></div>
      <div class="body">${renderObj(rec)}</div>
    </div>`;
  });
  outOsint.innerHTML = html;
  outOsint.innerHTML += `<details style="margin-top:10px"><summary>RAW LOG JSON</summary><pre class="raw">${esc(JSON.stringify(data,null,2))}</pre></details>`;
}

