/* ============ SMS-B LOGIC ============ */
const formSmsb = $("#form-smsb"), qSmsb = $("#q-smsb");
const outSmsb = $("#out-smsb"), statusSmsb = $("#status-smsb");
const countSmsb = $("#count-smsb"), delaySmsb = $("#delay-smsb");
const fireSmsb = $("#fire-smsb"), stopSmsb = $("#stop-smsb");
const bombMeter = $("#bomb-meter"), bombProgressBar = $("#bomb-progress-bar"), bombStatsTxt = $("#bomb-stats-txt");

let smsbRunning = false, smsbStopFlag = false, smsbSent = 0, smsbFailed = 0;

function setStatusSmsb(msg, cls){ statusSmsb.className = "status " + (cls||""); statusSmsb.innerHTML = msg || ""; }

async function fireOne(number){
  try{
    const r = await fetch(API_SMSB, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ number })
    });
    const txt = await r.text();
    let ok = r.ok;
    try { const j = JSON.parse(txt); if (j && (j.status===false || j.success===false)) ok = false; } catch {}
    return ok;
  }catch(e){ return false; }
}

fireSmsb.addEventListener("click", async () => {
  if (smsbRunning) return;
  const digits = qSmsb.value.replace(/\D/g,"");
  if (digits.length < 10){ setStatusSmsb("Target requires 10 digits", "err"); playSound("error"); return; }
  const count = Math.max(1, Math.min(500, parseInt(countSmsb.value) || 1));
  const delay = Math.max(0, Math.min(5, parseFloat(delaySmsb.value) || 0));
  outSmsb.innerHTML = "";
  smsbRunning = true; smsbStopFlag = false; smsbSent = 0; smsbFailed = 0;
  fireSmsb.disabled = true; stopSmsb.disabled = false;
  bombMeter.style.display = "flex";
  bombProgressBar.style.width = "0%";
  bombStatsTxt.textContent = `0 / ${count}`;
  playSound("scan");

  for (let i = 1; i <= count; i++){
    if (smsbStopFlag){
      setStatusSmsb(`Stress test aborted · Sent=${smsbSent} Failed=${smsbFailed}`, "err");
      playSound("error");
      smsbRunning = false; fireSmsb.disabled = false; stopSmsb.disabled = true;
      return;
    }
    const ok = await fireOne(digits);
    if (ok){ smsbSent++; playSound("packet"); } else { smsbFailed++; }
    const pct = Math.round((i / count) * 100);
    bombProgressBar.style.width = pct + "%";
    bombStatsTxt.textContent = `${i} / ${count} (${pct}%)`;
    setStatusSmsb(`Dispatching [${i}/${count}] · Sent: ${smsbSent} | Failed: ${smsbFailed}`);
    if (delay) await new Promise(r => setTimeout(r, delay * 1000));
  }
  setStatusSmsb(`Sequence completed · Dispatched: ${smsbSent} | Failed: ${smsbFailed}`, smsbSent > 0 ? "ok" : "err");
  playSound(smsbSent > 0 ? "success" : "error");
  smsbRunning = false; fireSmsb.disabled = false; stopSmsb.disabled = true;
});

stopSmsb.addEventListener("click", () => {
  if (!smsbRunning) return;
  smsbStopFlag = true;
  playSound("toggle");
  setStatusSmsb("Halting pipeline...", "err");
});

/* ============ YUKI CHAT LOGIC ============ */
const formYuki = $("#form-yuki"), qYuki = $("#q-yuki");
const chatYuki = $("#chat-yuki"), statusYuki = $("#status-yuki");
let yukiHistory = [];

function pushMsg(who, text){
  const cls = who === "me" ? "me" : who === "her" ? "her" : "sys";
  const div = document.createElement("div");
  div.className = "msg " + cls;
  if (who === "me") div.innerHTML = `<span class="who">OPERATOR</span>${esc(text)}`;
  else if (who === "her") div.innerHTML = `<span class="who">YUKI</span>${esc(text)}`;
  else div.textContent = text;
  chatYuki.appendChild(div);
  chatYuki.scrollTop = chatYuki.scrollHeight;
}

formYuki.addEventListener("submit", async e => {
  e.preventDefault();
  const msg = qYuki.value.trim();
  if (!msg) return;
  qYuki.value = "";
  playSound("tab");
  pushMsg("me", msg);
  yukiHistory.push({ role: "user", content: msg });
  yukiHistory = yukiHistory.slice(-20);
  statusYuki.className = "status";
  statusYuki.innerHTML = `<span class="loader purple"></span>Yuki is composing thoughts...`;
  $("#form-yuki button").disabled = true;
  try{
    const r = await fetch(API_YUKI, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message: msg, history: yukiHistory })
    });
    const data = await r.json();
    let reply = data.reply || data.response || data.message || data.text || data.result;
    if (!reply && typeof data === "object") reply = JSON.stringify(data);
    if (!reply) reply = "...";
    pushMsg("her", reply);
    playSound("success");
    yukiHistory.push({ role: "assistant", content: reply });
    yukiHistory = yukiHistory.slice(-20);
    statusYuki.innerHTML = "";
  }catch(e){
    statusYuki.className = "status err";
    playSound("error");
    statusYuki.textContent = "Neural timeout: " + e.message;
  }finally{
    $("#form-yuki button").disabled = false;
  }
});
